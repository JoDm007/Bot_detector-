# Configuration Telegram API & Bot
# Obtenez API_ID et API_HASH sur https://my.telegram.org (API development tools)
TG_API_ID=1234567
TG_API_HASH=votre_api_hash_ici

# Obtenez TG_BOT_TOKEN via @BotFather sur Telegram
TG_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Votre ID utilisateur Telegram (obtenez-le via @userinfobot)
TG_OWNER_ID=987654321
